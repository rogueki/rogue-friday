{
  "name": "@jarvis/web",
  "version": "1.0.0",
  "private": true,
  "description": "F.R.I.D.A.Y. Command Center Frontend",
  "type": "module",
  "scripts": {
    "dev": "node scripts/run-next.mjs dev --port 3000",
    "dev:mock": "node scripts/run-next.mjs dev --mock --port 3000",
    "build": "pnpm typecheck && node scripts/run-next.mjs build",
    "build:mock": "pnpm typecheck && node scripts/run-next.mjs build --mock",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "test": "vitest run",
    "screenshots": "node scripts/screenshot.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@jarvis/design-tokens": "workspace:*",
    "@jarvis/mock-data": "workspace:*",
    "@jarvis/orb": "workspace:*",
    "@jarvis/sdk": "workspace:*",
    "@jarvis/ui": "workspace:*",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-virtual": "^3.14.19",
    "@xstate/react": "^6.1.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.56.0",
    "motion": "^14.2.0",
    "msw": "^3.0.3",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "xstate": "^5.33.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}