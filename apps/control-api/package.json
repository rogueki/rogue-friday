{
  "name": "@jarvis/control-api",
  "version": "1.0.0",
  "private": true,
  "description": "Jarvis Control API",
  "type": "module",
  "scripts": {
    "generate:routes": "tsx scripts/generate-route-table.ts",
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "build": "tsup",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/static": "^10.1.6",
    "@jarvis/adapter-core": "workspace:*",
    "@jarvis/adapter-example-http": "workspace:*",
    "@jarvis/adapter-calendar-placeholder": "workspace:*",
    "@jarvis/adapter-hermes": "workspace:*",
    "@jarvis/adapter-hermes-placeholder": "workspace:*",
    "@jarvis/adapter-mail-placeholder": "workspace:*",
    "@jarvis/adapter-mock": "workspace:*",
    "@jarvis/adapter-system-local": "workspace:*",
    "@jarvis/adapter-system-placeholder": "workspace:*",
    "@jarvis/adapter-voice-http": "workspace:*",
    "@jarvis/adapter-voice-placeholder": "workspace:*",
    "@jarvis/auth": "workspace:*",
    "@jarvis/config": "workspace:*",
    "@jarvis/mock-data": "workspace:*",
    "@jarvis/observability": "workspace:*",
    "@jarvis/sdk": "workspace:*",
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-fastify": "^12.1.3",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fastify": "^5.12.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ws": "^8.22.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@swc/core": "^1.16.18",
    "@types/ws": "^8.18.2",
    "tsup": "^8.5.1"
  }
}
