# F.R.I.D.A.Y. Command Center - Umgebungsvariablen. Kopieren nach .env (wird nicht eingecheckt). Keine echten Werte hier ablegen.

# --- Laufzeit-Overrides (optional, schlagen dashboard.yaml) ---
# FRIDAY_DATA_MODE=live
# FRIDAY_HOST=127.0.0.1
# FRIDAY_PORT=3100
# FRIDAY_DATA_DIR=D:\Friday\dashboard\data
# FRIDAY_LOG_DIR=D:\Friday\dashboard\logs
# FRIDAY_CONFIG_DIR=D:\Friday\dashboard\config

# --- Owner-Login ---
# Hash erzeugen: pnpm --filter @friday/auth hash-password
# Wert in Single Quotes setzen, er enthaelt $-Zeichen.
FRIDAY_OWNER_PASSWORD_HASH=

# --- Adapter-Secrets ---
# Referenzen in config/adapters.yaml: env:NAME, wincred:ZIEL oder file:C:/Pfad/zur/Datei.
# Den Hermes-API-Key legt der Installer in C:/Friday/config/hermes_api.key ab (file:-Referenz, keine Variable noetig).

# --- Next.js Dev ---
# Ziel fuer das /api-Rewrite von "next dev" (Port 3000)
FRIDAY_API_ORIGIN=http://127.0.0.1:3100
