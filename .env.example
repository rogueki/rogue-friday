# JARVIS Command Center - Umgebungsvariablen. Kopieren nach .env (wird nicht eingecheckt). Keine echten Werte hier ablegen.

# --- Laufzeit-Overrides (optional, schlagen dashboard.yaml) ---
# JARVIS_DATA_MODE=mock
# JARVIS_HOST=127.0.0.1
# JARVIS_PORT=3100
# JARVIS_DATA_DIR=D:\Jarvis\dashboard\data
# JARVIS_LOG_DIR=D:\Jarvis\dashboard\logs
# JARVIS_CONFIG_DIR=D:\Jarvis\dashboard\config

# --- Owner-Login ---
# Hash erzeugen: pnpm --filter @jarvis/auth hash-password
# Wert in Single Quotes setzen, er enthaelt $-Zeichen.
JARVIS_OWNER_PASSWORD_HASH=

# --- Adapter-Secrets (nur hybrid/live) ---
# Referenzen in config/adapters.yaml: env:NAME, wincred:ZIEL oder file:C:/Pfad/zur/Datei.
# Den Hermes-API-Key legt der Installer in C:/Jarvis/config/hermes_api.key ab (file:-Referenz, keine Variable noetig).

# --- Next.js Dev ---
# Ziel fuer das /api-Rewrite von "next dev" (Port 3000)
JARVIS_API_ORIGIN=http://127.0.0.1:3100
