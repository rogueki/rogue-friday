{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis.local/schemas/common/secret-status.schema.json",
  "title": "SecretStatus",
  "description": "Secrets never leave the server; the browser only learns whether one is configured.",
  "type": "object",
  "properties": {
    "configured": {
      "type": "boolean"
    },
    "maskedHint": {
      "type": "string",
      "maxLength": 12
    }
  },
  "required": ["configured"],
  "additionalProperties": false
}
