{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis.local/schemas/common/list-envelope.schema.json",
  "title": "ListEnvelope",
  "description": "Generic cursor-paginated list envelope.",
  "type": "object",
  "properties": {
    "contractVersion": {
      "$ref": "../common/contract-version.schema.json"
    },
    "items": {
      "type": "array",
      "items": {}
    },
    "pageInfo": {
      "$ref": "../common/page-info.schema.json"
    },
    "freshness": {
      "$ref": "../common/freshness.schema.json"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "../common/source-descriptor.schema.json"
      }
    }
  },
  "required": ["contractVersion", "items", "pageInfo", "freshness", "sources"],
  "additionalProperties": false
}
