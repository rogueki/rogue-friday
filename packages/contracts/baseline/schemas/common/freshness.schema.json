{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis.local/schemas/common/freshness.schema.json",
  "title": "Freshness",
  "description": "Data age marker; stale data must never be rendered as live.",
  "type": "object",
  "properties": {
    "state": {
      "$ref": "../common/freshness-state.schema.json"
    },
    "asOf": {
      "type": ["string", "null"],
      "format": "date-time"
    }
  },
  "required": ["state", "asOf"],
  "additionalProperties": false
}
