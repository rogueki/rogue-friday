{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis.local/schemas/automations/automation.schema.json",
  "title": "Automation",
  "description": "Rule: trigger, conditions, actions, escalation (PLAN §35). version increments on every definition change.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^auto_[0-9A-Za-z]{26}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonic revision used for optimistic concurrency (If-Match)."
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source": {
      "$ref": "../common/source-descriptor.schema.json"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean"
    },
    "paused": {
      "type": "boolean"
    },
    "trigger": {
      "$ref": "../automations/automation-trigger.schema.json"
    },
    "conditions": {
      "type": "array",
      "items": {
        "$ref": "../automations/automation-condition.schema.json"
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "../automations/automation-action.schema.json"
      },
      "minItems": 1
    },
    "escalation": {
      "type": "array",
      "items": {
        "$ref": "../automations/escalation-step.schema.json"
      }
    },
    "nextRunAt": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "lastRunAt": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "lastSuccess": {
      "type": ["object", "null"],
      "properties": {
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "runId": {
          "type": "string",
          "pattern": "^run_[0-9A-Za-z]{26}$"
        }
      },
      "required": ["at", "runId"],
      "additionalProperties": false
    },
    "lastError": {
      "type": ["object", "null"],
      "properties": {
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "message": {
          "type": "string"
        },
        "runId": {
          "type": "string",
          "pattern": "^run_[0-9A-Za-z]{26}$"
        }
      },
      "required": ["at", "message", "runId"],
      "additionalProperties": false
    },
    "runCount": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "id",
    "version",
    "createdAt",
    "updatedAt",
    "source",
    "name",
    "enabled",
    "paused",
    "trigger",
    "conditions",
    "actions",
    "escalation",
    "nextRunAt",
    "lastRunAt",
    "lastSuccess",
    "lastError",
    "runCount"
  ],
  "additionalProperties": false
}
