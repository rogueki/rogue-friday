{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis.local/schemas/automations/automation-create-request.schema.json",
  "title": "AutomationCreateRequest",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "enabled": {
      "type": "boolean"
    },
    "trigger": {
      "$ref": "../automations/automation-trigger.schema.json"
    },
    "conditions": {
      "type": "array",
      "items": {
        "$ref": "../automations/automation-condition.schema.json"
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "../automations/automation-action.schema.json"
      },
      "minItems": 1
    },
    "escalation": {
      "type": "array",
      "items": {
        "$ref": "../automations/escalation-step.schema.json"
      }
    },
    "description": {
      "type": "string"
    }
  },
  "required": ["name", "trigger", "conditions", "actions"],
  "additionalProperties": false
}
