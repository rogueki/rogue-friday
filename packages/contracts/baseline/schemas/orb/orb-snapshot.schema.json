{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://friday.local/schemas/orb/orb-snapshot.schema.json",
  "title": "OrbSnapshot",
  "description": "Dominant orb status plus the parallel layers. Payload of GET /orb/status and friday.orb.status_changed.",
  "type": "object",
  "properties": {
    "status": {
      "$ref": "../orb/orb-status.schema.json"
    },
    "layers": {
      "$ref": "../orb/orb-layers.schema.json"
    }
  },
  "required": ["status", "layers"],
  "additionalProperties": false
}
