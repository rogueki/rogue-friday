{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://friday.local/schemas/calendar/calendar-conflict.schema.json",
  "title": "CalendarConflict",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^conf_[0-9A-Za-z]{26}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonic revision used for optimistic concurrency (If-Match)."
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source": {
      "$ref": "../common/source-descriptor.schema.json"
    },
    "eventIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^cal_[0-9A-Za-z]{26}$"
      },
      "minItems": 2
    },
    "kind": {
      "type": "string",
      "enum": ["overlap", "double_booking", "travel_time", "no_focus_time"]
    },
    "severity": {
      "$ref": "../common/severity.schema.json"
    },
    "description": {
      "type": "string"
    },
    "detectedAt": {
      "type": "string",
      "format": "date-time"
    },
    "suggestedResolution": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "version",
    "createdAt",
    "updatedAt",
    "source",
    "eventIds",
    "kind",
    "severity",
    "description",
    "detectedAt"
  ],
  "additionalProperties": false
}
