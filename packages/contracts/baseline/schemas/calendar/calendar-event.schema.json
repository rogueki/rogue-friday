{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://friday.local/schemas/calendar/calendar-event.schema.json",
  "title": "CalendarEvent",
  "description": "Calendar entry (PLAN §34). All times UTC; timeZone is the display zone of the event.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^cal_[0-9A-Za-z]{26}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonic revision used for optimistic concurrency (If-Match)."
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source": {
      "$ref": "../common/source-descriptor.schema.json"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "start": {
      "type": "string",
      "format": "date-time"
    },
    "end": {
      "type": "string",
      "format": "date-time"
    },
    "allDay": {
      "type": "boolean"
    },
    "timeZone": {
      "type": "string",
      "description": "IANA zone, e.g. Europe/Berlin."
    },
    "location": {
      "type": "string"
    },
    "attendees": {
      "type": "array",
      "items": {
        "$ref": "../calendar/attendee.schema.json"
      }
    },
    "status": {
      "type": "string",
      "enum": ["confirmed", "tentative", "cancelled"]
    },
    "reminderMinutes": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "linkedTaskIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^task_[0-9A-Za-z]{26}$"
      }
    },
    "linkedThreadIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^thr_[0-9A-Za-z]{26}$"
      }
    },
    "conflictIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^conf_[0-9A-Za-z]{26}$"
      }
    },
    "briefingId": {
      "type": ["string", "null"],
      "pattern": "^brief_[0-9A-Za-z]{26}$"
    }
  },
  "required": [
    "id",
    "version",
    "createdAt",
    "updatedAt",
    "source",
    "title",
    "start",
    "end",
    "allDay",
    "timeZone",
    "attendees",
    "status",
    "reminderMinutes",
    "linkedTaskIds",
    "linkedThreadIds",
    "conflictIds",
    "briefingId"
  ],
  "additionalProperties": false
}
