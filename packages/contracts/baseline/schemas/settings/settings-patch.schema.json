      "$ref": "../settings/theme-settings.schema.json"
    },
    "orb": {
      "$ref": "../settings/orb-settings.schema.json"
    },
    "navigation": {
      "$ref": "../settings/navigation-settings.schema.json"
    },
    "modelsRouting": {
      "$ref": "../settings/models-routing-settings.schema.json"
    },
    "voice": {
      "$ref": "../settings/voice-settings.schema.json"
    },
    "notifications": {
      "$ref": "../settings/notifications-settings.schema.json"
    },
    "security": {
      "$ref": "../settings/security-settings.schema.json"
    },
    "approvals": {
      "$ref": "../settings/approvals-settings.schema.json"
    },
    "dataRetention": {
      "$ref": "../settings/data-retention-settings.schema.json"
    },
