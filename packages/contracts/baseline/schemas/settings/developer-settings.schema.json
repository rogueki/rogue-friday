{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://friday.local/schemas/settings/developer-settings.schema.json",
  "title": "DeveloperSettings",
  "type": "object",
  "properties": {
    "debugMode": {
      "type": "boolean"
    },
    "showRawJson": {
      "type": "boolean"
    },
    "scenarioConsole": {
      "type": "boolean"
    },
    "orbPerfOverlay": {
      "type": "boolean"
    },
    "logLevel": {
      "type": "string",
      "enum": ["error", "warn", "info", "debug"]
    }
  },
  "required": ["debugMode", "showRawJson", "scenarioConsole", "orbPerfOverlay", "logLevel"],
  "additionalProperties": false
}
