{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://friday.local/schemas/settings/adapter-test-result.schema.json",
  "title": "AdapterTestResult",
  "type": "object",
  "properties": {
    "adapterId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "minLength": 1,
      "maxLength": 64
    },
    "success": {
      "type": "boolean"
    },
    "latencyMs": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "message": {
      "type": "string"
    },
    "testedAt": {
      "type": "string",
      "format": "date-time"
    },
    "correlationId": {
      "type": "string",
      "pattern": "^corr_[0-9A-Za-z]{26}$"
    }
  },
  "required": ["adapterId", "success", "latencyMs", "message", "testedAt", "correlationId"],
  "additionalProperties": false
}
