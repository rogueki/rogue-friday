{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis.local/schemas/settings/layout-widget.schema.json",
  "title": "LayoutWidget",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "minLength": 1,
      "maxLength": 64
    },
    "x": {
      "type": "integer",
      "minimum": 0
    },
    "y": {
      "type": "integer",
      "minimum": 0
    },
    "w": {
      "type": "integer",
      "minimum": 1
    },
    "h": {
      "type": "integer",
      "minimum": 1
    },
    "visible": {
      "type": "boolean"
    }
  },
  "required": ["id", "x", "y", "w", "h", "visible"],
  "additionalProperties": false
}
