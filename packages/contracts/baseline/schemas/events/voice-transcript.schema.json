{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://friday.local/schemas/events/voice-transcript.schema.json",
  "title": "VoiceTranscript",
  "type": "object",
  "properties": {
    "utteranceId": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "final": {
      "type": "boolean"
    },
    "confidence": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 1
    },
    "language": {
      "type": "string"
    },
    "speaker": {
      "type": ["string", "null"]
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": ["utteranceId", "text", "final", "language", "startedAt"],
  "additionalProperties": false
}
