{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://friday.local/schemas/memory/memory-export.schema.json",
  "title": "MemoryExport",
  "description": "JSON export of the memory store (PLAN §30.3). Never contains secrets: restricted memories are omitted and only counted.",
  "type": "object",
  "properties": {
    "contractVersion": {
      "$ref": "../common/contract-version.schema.json"
    },
    "exportedAt": {
      "type": "string",
      "format": "date-time"
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of exported memories (items.length)."
    },
    "omittedRestricted": {
      "type": "integer",
      "minimum": 0,
      "description": "Memories with sensitivity restricted that were left out."
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "../memory/memory.schema.json"
      }
    }
  },
  "required": ["contractVersion", "exportedAt", "count", "omittedRestricted", "items"],
  "additionalProperties": false
}
