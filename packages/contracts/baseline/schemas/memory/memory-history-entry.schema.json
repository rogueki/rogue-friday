{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://friday.local/schemas/memory/memory-history-entry.schema.json",
  "title": "MemoryHistoryEntry",
  "type": "object",
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "changedAt": {
      "type": "string",
      "format": "date-time"
    },
    "actor": {
      "$ref": "../common/actor.schema.json"
    },
    "change": {
      "type": "string",
      "enum": ["created", "updated", "confirmed", "locked", "unlocked", "pinned", "deleted", "expired"]
    },
    "summary": {
      "type": "string"
    },
    "before": {
      "type": ["string", "null"]
    },
    "after": {
      "type": ["string", "null"]
    }
  },
  "required": ["version", "changedAt", "actor", "change", "summary", "before", "after"],
  "additionalProperties": false
}
