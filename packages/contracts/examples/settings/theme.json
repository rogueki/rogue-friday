{
  "$schema": "https://friday.local/schemas/settings/theme.schema.json",
  "id": "friday-command-gold-core",
  "name": "Friday Command / Gold Core",
  "builtIn": true,
  "tokens": {
    "color.primary": "#27dcff",
    "color.background": "#01060c",
    "color.orb": "#ffb52e",
    "color.orbHot": "#fff2ba"
