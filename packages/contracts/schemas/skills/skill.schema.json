{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://friday.local/schemas/skills/skill.schema.json",
  "title": "SkillCatalogEntry",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^(friday|hermes):[a-z0-9][a-z0-9_-]*$" },
    "source": { "enum": ["friday", "hermes"] },
    "origin": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,31}$" },
    "trust": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,31}$" },
    "name": { "type": "string", "minLength": 1 },
    "category": { "type": "string" },
    "description": { "type": "string" },
    "version": { "type": ["string", "null"] },
    "packaged": { "type": "boolean" },
    "discovered": { "type": ["boolean", "null"] },
    "enabled": { "type": ["boolean", "null"] },
    "observedAt": { "type": ["string", "null"], "format": "date-time" },
    "observationSource": { "type": "string" },
    "observationError": { "type": ["string", "null"] },
    "accounts": { "type": "array", "items": { "type": "string" } },
    "setupRefs": { "type": "array", "items": { "type": "string" } },
    "integrationRefs": { "type": "array", "items": { "type": "string" } }
    ,"requiredCapabilities": { "type": "array", "items": { "type": "string" } }
    ,"conditionalCapabilities": { "type": "array", "items": { "type": "string" } }
    ,"integrationDetails": { "type": "array", "items": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "account": { "enum": ["none", "required", "conditional"] },
        "required": { "type": "boolean" },
        "setupDe": { "type": "string" },
        "reference": { "type": "string" },
        "settingsTarget": { "type": "string" },
        "permissions": {
          "type": "object",
          "properties": {
            "required_prerequisites": { "type": "array", "items": { "$ref": "#/$defs/prerequisite" } },
            "optional_prerequisites": { "type": "array", "items": { "$ref": "#/$defs/prerequisite" } },
            "scope_status": { "enum": ["unknown", "not_required"] },
            "scope_notice": { "type": "string" }
          },
          "required": ["required_prerequisites", "optional_prerequisites", "scope_status", "scope_notice"],
          "additionalProperties": false
        },
        "cost": {
          "type": "object",
          "properties": {
            "model": { "enum": ["host_resources", "provider_usage", "subscription_license", "none", "unknown"] },
            "notice": { "type": "string" }
          },
          "required": ["model", "notice"],
          "additionalProperties": false
        },
        "configured": { "type": ["boolean", "null"] },
        "connectionChecked": { "type": ["boolean", "null"] }
      },
      "required": ["id", "account", "required", "setupDe", "reference", "settingsTarget", "configured", "connectionChecked"],
      "additionalProperties": false
    } }
  },
  "required": ["id", "source", "origin", "trust", "name", "category", "description", "version", "packaged", "discovered", "enabled", "observedAt", "observationSource", "observationError", "accounts", "setupRefs", "integrationRefs", "integrationDetails", "requiredCapabilities", "conditionalCapabilities"],
  "additionalProperties": false,
  "$defs": {
    "prerequisite": {
      "type": "object",
      "properties": { "kind": { "type": "string" }, "status": { "enum": ["required", "optional"] }, "notice": { "type": "string" } },
      "required": ["kind", "status", "notice"],
      "additionalProperties": false
    }
  }
}
