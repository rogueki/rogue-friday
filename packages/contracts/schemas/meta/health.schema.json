{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://friday.local/schemas/meta/health.schema.json",
  "title": "Health",
  "description": "Liveness/readiness summary of the control API and its components.",
  "type": "object",
  "properties": {
    "contractVersion": {
      "$ref": "../common/contract-version.schema.json"
    },
    "status": {
      "$ref": "../common/health-status.schema.json"
    },
    "checkedAt": {
      "type": "string",
      "format": "date-time"
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "$ref": "../common/health-status.schema.json"
          },
          "latencyMs": {
            "type": ["integer", "null"],
            "minimum": 0
          }
        },
        "required": ["id", "name", "status", "latencyMs"],
        "additionalProperties": false
      }
    }
  },
  "required": ["contractVersion", "status", "checkedAt", "components"],
  "additionalProperties": false
}
