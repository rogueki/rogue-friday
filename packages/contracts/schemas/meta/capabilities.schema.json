{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis.local/schemas/meta/capabilities.schema.json",
  "title": "Capabilities",
  "description": "Per-module capability flags (PLAN §9). The UI derives enabled/disabled actions from this document.",
  "type": "object",
  "properties": {
    "contractVersion": {
      "$ref": "../common/contract-version.schema.json"
    },
    "modules": {
      "type": "object",
      "properties": {
        "tasks": {
          "$ref": "#/$defs/TasksCapability"
        },
        "activity": {
          "$ref": "#/$defs/ActivityCapability"
        },
        "memory": {
          "$ref": "#/$defs/MemoryCapability"
        },
        "agents": {
          "$ref": "#/$defs/AgentsCapability"
        },
        "approvals": {
          "$ref": "#/$defs/ApprovalsCapability"
        },
        "mail": {
          "$ref": "#/$defs/MailCapability"
        },
        "communication": {
          "$ref": "#/$defs/CommunicationCapability"
        },
        "calendar": {
          "$ref": "#/$defs/CalendarCapability"
        },
        "automations": {
          "$ref": "#/$defs/AutomationsCapability"
        },
        "research": {
          "$ref": "#/$defs/ResearchCapability"
        },
        "files": {
          "$ref": "#/$defs/FilesCapability"
        },
        "voice": {
          "$ref": "#/$defs/VoiceCapability"
        },
        "notifications": {
          "$ref": "#/$defs/NotificationsCapability"
        },
        "system": {
          "$ref": "#/$defs/SystemCapability"
        },
        "audit": {
          "$ref": "#/$defs/AuditCapability"
        },
        "commands": {
          "$ref": "#/$defs/CommandsCapability"
        },
        "telephony": {
          "$ref": "#/$defs/TelephonyCapability"
        }
      },
      "required": [
        "tasks",
        "activity",
        "memory",
        "agents",
        "approvals",
        "mail",
        "communication",
        "calendar",
        "automations",
        "research",
        "files",
        "voice",
        "notifications",
        "system",
        "audit",
        "commands",
        "telephony"
      ],
      "additionalProperties": false
    }
  },
  "required": ["contractVersion", "modules"],
  "additionalProperties": false,
  "$defs": {
    "TasksCapability": {
      "type": "object",
      "title": "TasksCapability",
      "properties": {
        "read": {
          "type": "boolean"
        },
        "create": {
          "type": "boolean"
        },
        "update": {
          "type": "boolean"
        },
        "cancel": {
          "type": "boolean"
        },
        "retry": {
          "type": "boolean"
        },
        "pause": {
          "type": "boolean"
        },
        "resume": {
          "type": "boolean"
        },
        "stream": {
          "type": "boolean"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "minLength": 1,
            "maxLength": 64
          }
        }
      },
      "required": ["read", "create", "update", "cancel", "retry", "pause", "resume", "stream", "sources"],
      "additionalProperties": false
    },
