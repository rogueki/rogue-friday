{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://friday.local/schemas/content-studio/plan-document.schema.json",
  "title": "ContentPlanDocument",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "exportiert_am": {
      "type": "string",
      "format": "date-time"
    },
    "content": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "titel": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "plattform": {
            "type": "string",
            "enum": [
              "LinkedIn",
              "Instagram",
              "Facebook",
              "TikTok",
              "YouTube",
              "Beide"
            ]
          },
          "ziele": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "LinkedIn",
                "Instagram",
                "Facebook",
                "TikTok",
                "YouTube"
              ]
            },
            "minItems": 1,
            "maxItems": 5,
            "uniqueItems": true
          },
          "format": {
            "type": "string",
            "enum": [
              "Reel",
              "Feed-Post",
              "Story",
              "Karussell",
              "LinkedIn-Video",
              "LinkedIn-Karussell",
              "TikTok-Video",
              "YouTube-Video",
              "YouTube-Short"
            ]
          },
          "beschreibung": {
            "type": "string",
            "maxLength": 10000
          },
          "zieldatum": {
            "type": "string",
            "pattern": "^$|^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "idee",
              "in-arbeit",
              "fertig"
            ]
          }
        },
        "required": [
          "id",
          "titel",
          "plattform",
          "format",
          "beschreibung",
          "zieldatum",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "postings": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "datum": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "uhrzeit": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          },
          "plattform": {
            "type": "string",
            "enum": [
              "LinkedIn",
              "Instagram",
              "Facebook",
              "TikTok",
              "YouTube"
            ]
          },
          "ziele": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "LinkedIn",
                "Instagram",
                "Facebook",
                "TikTok",
                "YouTube"
              ]
            },
            "minItems": 1,
            "maxItems": 5,
            "uniqueItems": true
          },
          "format": {
            "type": "string",
            "enum": [
              "Reel",
              "Feed-Post",
              "Story",
              "Karussell",
              "LinkedIn-Video",
              "LinkedIn-Karussell",
              "TikTok-Video",
              "YouTube-Video",
              "YouTube-Short"
            ]
          },
          "titel": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "status": {
            "type": "string",
            "enum": [
              "geplant",
              "gepostet",
              "verpasst"
            ]
          },
          "veroeffentlichung": {
            "description": "Nur bei status=gepostet: manuell markiert oder durch einen angebundenen Publisher bestaetigt.",
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "art": {
                    "type": "string",
                    "enum": [
                      "manuell",
                      "bestaetigt"
                    ]
                  },
                  "am": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "quelle": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 60
                  }
                },
                "required": [
                  "art",
                  "am",
                  "quelle"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "id",
          "datum",
          "uhrzeit",
          "plattform",
          "format",
          "titel",
          "status"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "content",
    "postings"
  ],
  "additionalProperties": false
}
