{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://friday.local/schemas/integrations/hermes-mcp-probe-response.schema.json",
  "title": "HermesMcpProbeResponse",
  "type": "object",
  "properties": {
    "contractVersion": { "$ref": "../common/contract-version.schema.json" },
    "data": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "revision": { "type": "integer", "minimum": 1 },
        "checkedAt": { "type": "string", "format": "date-time" },
        "connected": { "type": "boolean" },
        "toolCount": { "type": ["integer", "null"], "minimum": 0 },
        "toolCountComplete": { "type": "boolean" },
        "failureClass": { "enum": ["auth_required", "config_invalid", "connect_failed", "protocol_failed", "protocol_unsupported", "redirect_rejected", "private_or_unresolved_address", null] },
        "runtimeApplied": { "type": "null" }
      },
      "required": ["name", "revision", "checkedAt", "connected", "toolCount", "toolCountComplete", "failureClass", "runtimeApplied"],
      "additionalProperties": false
    },
    "freshness": { "$ref": "../common/freshness.schema.json" }
  },
  "required": ["contractVersion", "data", "freshness"],
  "additionalProperties": false
}
