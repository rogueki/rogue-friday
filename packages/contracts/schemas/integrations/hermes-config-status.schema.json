{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://friday.local/schemas/integrations/hermes-config-status.schema.json",
  "title": "HermesConfigStatus",
  "type": "object",
  "properties": {
    "installed": { "type": "boolean" },
    "sourceRevision": { "type": ["string", "null"] },
    "revision": { "type": ["integer", "null"], "minimum": 1 },
    "checkedAt": { "type": "string", "format": "date-time" },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "enum": [
              "model.provider",
              "model.default",
              "model.base_url",
              "agent.reasoning_effort",
              "fallback.min_switch_reset_seconds",
              "fallback_model",
              "agent.auto_recovery_cycles",
              "agent.run_budget_seconds",
              "agent.budget_warning_ratio",
              "agent.agent_cache.max_size",
              "max_concurrent_sessions",
              "context_file_max_chars",
              "compression.enabled",
              "compression.threshold",
              "compression.target_ratio",
              "compression.tail_mode",
              "compression.protect_last_n",
              "agent.max_turns",
              "agent.gateway_timeout",
              "agent.api_max_retries",
              "session.terminal_continue",
              "max_live_sessions",
              "terminal.timeout",
              "terminal.container_cpu",
              "terminal.container_memory",
              "terminal.container_disk",
              "terminal.container_persistent",
              "terminal.backend",
              "terminal.cwd",
              "terminal.docker_network",
              "terminal.docker_mount_cwd_to_workspace",
              "terminal.docker_volumes",
              "browser.command_timeout",
              "browser.snapshot_threshold",
              "browser.inactivity_timeout",
              "browser.engine",
              "browser.headed",
              "browser.auto_local_for_private_urls",
              "browser.dialog_policy",
              "browser.dialog_timeout_s",
              "browser.allow_private_urls",
              "browser.use_real_profile",
              "browser.real_profile_pin",
              "browser.restrict_evaluate",
              "browser.allow_unsafe_evaluate",
              "code_execution.mode",
              "code_execution.kernel_idle_timeout",
              "code_execution.max_session_kernels",
              "computer_use.permission_mode",
              "computer_use.capability_manifest",
              "computer_use.max_image_dimension",
              "computer_use.ax_max_elements",
              "computer_use.capture_after_mode",
              "toolsets",
              "command_allowlist",
              "approvals.mode",
              "approvals.timeout",
              "approvals.denial_breaker_threshold",
              "approvals.deny",
              "approvals.destructive_slash_confirm",
              "approvals.mcp_reload_confirm",
              "approvals.single_query_mode",
              "approvals.unattended_mode",
              "security.protected_instruction_files",
              "skills.disabled",
              "cron.catch_up_missed",
              "cron.allow_agent_scheduling",
              "cron.preflight",
              "cron.max_parallel_jobs",
              "cron.output_retention",
              "cron.script_timeout_seconds",
              "cron.session_db_timeout_seconds",
              "cron.failure_repeat_alert_hours",
              "cron.require_restart_safe_scope",
              "kanban.max_in_progress",
              "kanban.max_in_progress_per_profile",
              "kanban.max_spawn",
              "kanban.failure_limit",
              "kanban.dispatch_stale_timeout_seconds",
              "gateway.loop_watchdog",
              "gateway.startup_watchdog",
              "gateway.startup_watchdog_timeout_seconds",
              "gateway.restart_loop_guard.max_restarts",
              "gateway.respawn_storm.max_starts",
              "gateway.signal_interrupt_grace_timeout",
              "logging.level",
              "logging.max_size_mb",
              "logging.backup_count"
            ]
          },
          "type": { "enum": ["integer", "optionalInteger", "number", "optionalNumber", "boolean", "string", "fallback", "skillNames", "textList"] },
          "family": { "enum": ["agent", "models", "execution", "extensions", "operations"] },
          "consumer": { "type": "string" },
          "value": { "anyOf": [{ "type": ["number", "boolean", "string", "null"] }, { "type": "array", "maxItems": 8,
            "items": { "type": "object", "properties": { "provider": { "type": "string" }, "model": { "type": "string" } },
              "required": ["provider", "model"], "additionalProperties": false } },
            { "type": "array", "maxItems": 512, "items": { "type": "string" } }] },
          "explicit": { "type": "boolean" },
          "writable": { "type": "boolean" },
          "verification": { "const": "unverified" },
          "reasonCode": { "const": "runtime_receipt_unavailable" }
        },
        "required": [
          "key",
          "type",
          "family",
          "consumer",
          "value",
          "explicit",
          "writable",
          "verification",
          "reasonCode"
        ],
        "additionalProperties": false
      }
    },
    "secretStates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": { "enum": ["model.api_key", "OPENROUTER_API_KEY", "OPENAI_API_KEY", "ANTHROPIC_API_KEY"] },
          "configFileSet": { "type": "boolean" },
          "effectiveConfigured": { "type": ["boolean", "null"] }
        },
        "required": ["key", "configFileSet", "effectiveConfigured"],
        "additionalProperties": false
      }
    },
    "families": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "enum": ["models", "agent", "execution", "extensions", "operations"] },
          "roots": { "type": "array", "items": { "type": "string" } },
          "followup": { "type": "string" },
          "installed": { "type": ["boolean", "null"] },
          "enabled": { "type": ["boolean", "null"] },
          "configFileSet": { "type": "boolean" },
          "configured": { "type": ["boolean", "null"] },
          "authenticated": { "type": ["boolean", "null"] },
          "available": { "type": ["boolean", "null"] },
          "needsSetup": { "type": ["boolean", "null"] },
          "unsupported": { "type": ["boolean", "null"] },
          "coverage": { "const": "followup" }
        },
        "required": [
          "id",
          "roots",
          "followup",
          "installed",
          "enabled",
          "configFileSet",
          "configured",
          "authenticated",
          "available",
          "needsSetup",
          "unsupported",
          "coverage"
        ],
        "additionalProperties": false
      }
    },
    "inventory": {
      "type": "object",
      "properties": {
        "scope": { "const": "profile" },
        "skillsComplete": { "type": "boolean" },
        "pluginsComplete": { "type": "boolean" },
        "modelProvidersComplete": { "type": "boolean" },
        "reasons": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["scope", "skillsComplete", "pluginsComplete", "modelProvidersComplete", "reasons"],
      "additionalProperties": false
    },
    "skills": { "type": "array", "items": { "$ref": "#/$defs/extension" } },
    "modelProviders": { "type": "array", "items": { "type": "object",
      "properties": { "id": { "type": "string" }, "configFileSet": { "type": "boolean" },
        "authenticated": { "type": ["boolean", "null"] }, "available": { "type": ["boolean", "null"] } },
      "required": ["id", "configFileSet", "authenticated", "available"], "additionalProperties": false } },
    "plugins": { "type": "array", "items": { "$ref": "#/$defs/extension" } },
    "mcpComplete": { "type": "boolean" },
    "mcpServers": { "type": "array", "items": { "type": "object", "properties": {
      "id": { "type": "string" }, "transport": { "enum": ["http", "stdio", "unknown"] },
      "enabled": { "type": ["boolean", "null"] }, "endpoint": { "type": ["string", "null"] },
      "editable": { "type": "boolean" }, "authMode": { "enum": ["none", "bearer", "oauth", "unknown"] },
      "credentialConfigured": { "type": ["boolean", "null"] }
    }, "required": ["id", "transport", "enabled", "endpoint", "editable", "authMode", "credentialConfigured"], "additionalProperties": false } },
    "write": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "properties": {
            "key": { "type": "string" },
            "persisted": { "type": "boolean" },
            "applied": { "type": ["boolean", "null"] },
            "verification": { "const": "unverified" },
            "reasonCode": { "enum": ["runtime_receipt_unavailable", "readback_mismatch"] }
          },
          "required": ["key", "persisted", "applied", "verification", "reasonCode"],
          "additionalProperties": false
        }
      ]
    }
  },
  "$defs": {
    "extension": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "installed": { "const": true },
        "enabled": { "type": ["boolean", "null"] },
        "configured": { "type": ["boolean", "null"] },
        "authenticated": { "type": ["boolean", "null"] },
        "available": { "type": ["boolean", "null"] },
        "needsSetup": { "type": ["boolean", "null"] },
        "unsupported": { "type": ["boolean", "null"] }
      },
      "required": [
        "id",
        "installed",
        "enabled",
        "configured",
        "authenticated",
        "available",
        "needsSetup",
        "unsupported"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "installed",
    "sourceRevision",
    "revision",
    "checkedAt",
    "fields",
    "secretStates",
    "families",
    "inventory",
    "modelProviders",
    "skills",
    "plugins",
    "mcpComplete",
    "mcpServers",
    "write"
  ],
  "additionalProperties": false
}
