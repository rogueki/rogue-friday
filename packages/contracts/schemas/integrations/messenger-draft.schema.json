{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://friday.local/schemas/integrations/messenger-draft.schema.json","title":"MessengerDraft","type":"object","properties":{"accountId":{"const":"default"},"platform":{"enum":["telegram","discord","whatsapp","slack","signal","matrix","mattermost","sms","irc","line","feishu","wecom","photon","buzz","ntfy","teams","google_chat","simplex","weixin","bluebubbles","dingtalk","whatsapp_cloud","qqbot"]},"recipient":{"type":"string","pattern":"^[A-Za-z0-9_@.!+#:;/=-]{1,128}$"},"text":{"type":"string","minLength":1,"maxLength":8192},"notificationId":{"type":"string","pattern":"^[A-Za-z0-9_-]{1,128}$"},"notificationStep":{"type":"integer","minimum":1,"maximum":32}},"dependentRequired":{"notificationId":["notificationStep"],"notificationStep":["notificationId"]},"required":["accountId","platform","recipient","text"],"additionalProperties":false}
