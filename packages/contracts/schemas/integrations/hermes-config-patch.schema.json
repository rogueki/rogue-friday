{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://friday.local/schemas/integrations/hermes-config-patch.schema.json",
  "title": "HermesConfigPatch",
  "oneOf": [
    {
      "type": "object",
      "properties": { "key": { "const": "model.provider" }, "value": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,64}$" } },
      "required": ["key", "value"], "additionalProperties": false
    },
    {
      "type": "object",
      "properties": { "key": { "const": "model.default" }, "value": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^\\s\\x00-\\x1f\\x7f]+$" } },
      "required": ["key", "value"], "additionalProperties": false
    },
    {
      "type": "object",
      "properties": { "key": { "const": "agent.reasoning_effort" }, "value": { "enum": ["", "none", "minimal", "low", "medium", "high", "xhigh", "max", "ultra"] } },
      "required": ["key", "value"], "additionalProperties": false
    },
    {
      "type": "object",
      "properties": { "key": { "const": "fallback.min_switch_reset_seconds" }, "value": { "type": "integer", "minimum": 0, "maximum": 3600 } },
      "required": ["key", "value"], "additionalProperties": false
    },
    {
      "type": "object",
      "properties": { "key": { "const": "fallback_model" }, "value": { "type": "array", "maxItems": 8, "items": { "type": "object",
        "properties": { "provider": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,64}$" },
          "model": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^\\s\\x00-\\x1f\\x7f]+$" } },
        "required": ["provider", "model"], "additionalProperties": false } } },
      "required": ["key", "value"], "additionalProperties": false
    },
    { "type": "object", "properties": { "key": { "const": "agent.auto_recovery_cycles" }, "value": { "type": "integer", "minimum": 0, "maximum": 20 } }, "required": ["key", "value"], "additionalProperties": false },
    { "type": "object", "properties": { "key": { "const": "agent.run_budget_seconds" }, "value": { "anyOf": [{ "type": "integer", "minimum": 1, "maximum": 86400 }, { "type": "null" }] } }, "required": ["key", "value"], "additionalProperties": false },
    { "type": "object", "properties": { "key": { "const": "agent.budget_warning_ratio" }, "value": { "anyOf": [{ "type": "number", "minimum": 0.01, "maximum": 0.99 }, { "type": "null" }] } }, "required": ["key", "value"], "additionalProperties": false },
    { "type": "object", "properties": { "key": { "const": "agent.agent_cache.max_size" }, "value": { "type": "integer", "minimum": 1, "maximum": 4096 } }, "required": ["key", "value"], "additionalProperties": false },
    { "type": "object", "properties": { "key": { "const": "max_concurrent_sessions" }, "value": { "type": "integer", "minimum": 0, "maximum": 10000 } }, "required": ["key", "value"], "additionalProperties": false },
    { "type": "object", "properties": { "key": { "const": "context_file_max_chars" }, "value": { "type": "integer", "minimum": 0, "maximum": 1000000 } }, "required": ["key", "value"], "additionalProperties": false },
    { "type": "object", "properties": { "key": { "const": "compression.enabled" }, "value": { "type": "boolean" } }, "required": ["key", "value"], "additionalProperties": false },
    { "type": "object", "properties": { "key": { "const": "compression.threshold" }, "value": { "type": "number", "minimum": 0.1, "maximum": 0.95 } }, "required": ["key", "value"], "additionalProperties": false },
    { "type": "object", "properties": { "key": { "const": "compression.target_ratio" }, "value": { "type": "number", "minimum": 0.1, "maximum": 0.8 } }, "required": ["key", "value"], "additionalProperties": false },
    { "type": "object", "properties": { "key": { "const": "compression.tail_mode" }, "value": { "enum": ["lean", "legacy"] } }, "required": ["key", "value"], "additionalProperties": false },
    { "type": "object", "properties": { "key": { "const": "compression.protect_last_n" }, "value": { "type": "integer", "minimum": 0, "maximum": 100 } }, "required": ["key", "value"], "additionalProperties": false },
    {
      "type": "object",
      "properties": {
        "key": { "const": "agent.max_turns" },
        "value": { "type": "integer", "minimum": 1, "maximum": 100000 }
      },
      "required": ["key", "value"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "key": { "const": "agent.gateway_timeout" },
        "value": { "type": "integer", "minimum": 60, "maximum": 86400 }
      },
      "required": ["key", "value"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "key": { "const": "agent.api_max_retries" },
        "value": { "type": "integer", "minimum": 1, "maximum": 10 }
      },
      "required": ["key", "value"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": { "key": { "const": "session.terminal_continue" }, "value": { "type": "boolean" } },
      "required": ["key", "value"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "key": { "const": "max_live_sessions" },
        "value": { "type": "integer", "minimum": 0, "maximum": 10000 }
      },
      "required": ["key", "value"],
      "additionalProperties": false
    },
    { "type": "object", "properties": { "key": { "const": "terminal.timeout" }, "value": { "type": "integer", "minimum": 1, "maximum": 3600 } }, "required": ["key", "value"], "additionalProperties": false },
    { "type": "object", "properties": { "key": { "const": "terminal.container_cpu" }, "value": { "type": "number", "minimum": 0.01, "maximum": 1024 } }, "required": ["key", "value"], "additionalProperties": false },
    { "type": "object", "properties": { "key": { "const": "terminal.container_memory" }, "value": { "type": "integer", "minimum": 1, "maximum": 1048576 } }, "required": ["key", "value"], "additionalProperties": false },
    { "type": "object", "properties": { "key": { "const": "terminal.container_disk" }, "value": { "type": "integer", "minimum": 1, "maximum": 1048576 } }, "required": ["key", "value"], "additionalProperties": false },
    { "type": "object", "properties": { "key": { "const": "terminal.backend" }, "value": { "enum": ["local", "docker"] } }, "required": ["key", "value"], "additionalProperties": false },
    { "type": "object", "properties": { "key": { "const": "terminal.cwd" }, "value": { "type": "string", "maxLength": 512, "pattern": "^(\\.|/[^\\x00-\\x1f\\x7f-\\x9f]+)$" } }, "required": ["key", "value"], "additionalProperties": false },
    { "type": "object", "properties": { "key": { "const": "terminal.docker_network" }, "value": { "type": "boolean" } }, "required": ["key", "value"], "additionalProperties": false },
    { "type": "object", "properties": { "key": { "const": "terminal.docker_mount_cwd_to_workspace" }, "value": { "type": "boolean" } }, "required": ["key", "value"], "additionalProperties": false },
    { "type": "object", "properties": { "key": { "const": "terminal.docker_volumes" }, "value": { "type": "array", "maxItems": 8, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f]+$" } } }, "required": ["key", "value"], "additionalProperties": false },
    { "type": "object", "properties": { "key": { "const": "browser.command_timeout" }, "value": { "type": "integer", "minimum": 5, "maximum": 600 } }, "required": ["key", "value"], "additionalProperties": false },
    { "type": "object", "properties": { "key": { "const": "browser.snapshot_threshold" }, "value": { "type": "integer", "minimum": 1000, "maximum": 200000 } }, "required": ["key", "value"], "additionalProperties": false },
    { "type": "object", "properties": { "key": { "const": "browser.inactivity_timeout" }, "value": { "type": "integer", "minimum": 30, "maximum": 3600 } }, "required": ["key", "value"], "additionalProperties": false },
    { "type": "object", "properties": { "key": { "const": "browser.dialog_policy" }, "value": { "enum": ["must_respond", "auto_dismiss"] } }, "required": ["key", "value"], "additionalProperties": false },
    { "type": "object", "properties": { "key": { "const": "browser.dialog_timeout_s" }, "value": { "type": "integer", "minimum": 1, "maximum": 3600 } }, "required": ["key", "value"], "additionalProperties": false },
    { "type": "object", "properties": { "key": { "const": "browser.allow_private_urls" }, "value": { "type": "boolean" } }, "required": ["key", "value"], "additionalProperties": false },
    { "type": "object", "properties": { "key": { "const": "browser.use_real_profile" }, "value": { "type": "boolean" } }, "required": ["key", "value"], "additionalProperties": false },
    { "type": "object", "properties": { "key": { "const": "browser.real_profile_pin" }, "value": { "type": "string", "pattern": "^(|Default|Profile [0-9]{1,3})$" } }, "required": ["key", "value"], "additionalProperties": false },
    { "type": "object", "properties": { "key": { "const": "browser.restrict_evaluate" }, "value": { "type": "boolean" } }, "required": ["key", "value"], "additionalProperties": false },
    { "type": "object", "properties": { "key": { "const": "browser.allow_unsafe_evaluate" }, "value": { "type": "boolean" } }, "required": ["key", "value"], "additionalProperties": false },
    { "type": "object", "properties": { "key": { "const": "code_execution.mode" }, "value": { "enum": ["project", "strict"] } }, "required": ["key", "value"], "additionalProperties": false },
    { "type": "object", "properties": { "key": { "const": "code_execution.kernel_idle_timeout" }, "value": { "type": "integer", "minimum": 30, "maximum": 86400 } }, "required": ["key", "value"], "additionalProperties": false },
    { "type": "object", "properties": { "key": { "const": "code_execution.max_session_kernels" }, "value": { "type": "integer", "minimum": 1, "maximum": 32 } }, "required": ["key", "value"], "additionalProperties": false },
    { "type": "object", "properties": { "key": { "const": "computer_use.permission_mode" }, "value": { "enum": ["standard", "bounded"] } }, "required": ["key", "value"], "additionalProperties": false },
    { "type": "object", "properties": { "key": { "const": "computer_use.capability_manifest" }, "value": { "type": "string", "maxLength": 512, "pattern": "^(|/[^\\x00-\\x1f\\x7f-\\x9f]+)$" } }, "required": ["key", "value"], "additionalProperties": false },
    { "type": "object", "properties": { "key": { "const": "computer_use.max_image_dimension" }, "value": { "type": "integer", "minimum": 320, "maximum": 4096 } }, "required": ["key", "value"], "additionalProperties": false },
    { "type": "object", "properties": { "key": { "const": "computer_use.ax_max_elements" }, "value": { "type": "integer", "minimum": 50, "maximum": 1000 } }, "required": ["key", "value"], "additionalProperties": false },
    { "type": "object", "properties": { "key": { "const": "computer_use.capture_after_mode" }, "value": { "enum": ["som", "ax", "vision"] } }, "required": ["key", "value"], "additionalProperties": false },
    { "type": "object", "properties": { "key": { "const": "toolsets" }, "value": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[!-~]+$" } } }, "required": ["key", "value"], "additionalProperties": false },
    { "type": "object", "properties": { "key": { "const": "command_allowlist" }, "value": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[ -~]+$" } } }, "required": ["key", "value"], "additionalProperties": false },
    { "type": "object", "properties": { "key": { "const": "approvals.mode" }, "value": { "enum": ["manual", "smart"] } }, "required": ["key", "value"], "additionalProperties": false },
    { "type": "object", "properties": { "key": { "const": "approvals.timeout" }, "value": { "type": "integer", "minimum": 15, "maximum": 600 } }, "required": ["key", "value"], "additionalProperties": false },
    { "type": "object", "properties": { "key": { "const": "approvals.single_query_mode" }, "value": { "const": "deny" } }, "required": ["key", "value"], "additionalProperties": false },
    { "type": "object", "properties": { "key": { "const": "approvals.unattended_mode" }, "value": { "const": "deny" } }, "required": ["key", "value"], "additionalProperties": false },
    { "type": "object", "properties": { "key": { "const": "security.protected_instruction_files" }, "value": { "const": true } }, "required": ["key", "value"], "additionalProperties": false },
    { "type": "object", "properties": { "key": { "const": "skills.disabled" }, "value": { "type": "array", "maxItems": 512, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9._/-]{1,100}$" } } }, "required": ["key", "value"], "additionalProperties": false },
    { "type": "object", "properties": { "key": { "enum": ["cron.catch_up_missed", "cron.allow_agent_scheduling", "cron.preflight", "cron.require_restart_safe_scope", "gateway.loop_watchdog", "gateway.startup_watchdog"] }, "value": { "type": "boolean" } }, "required": ["key", "value"], "additionalProperties": false },
    { "type": "object", "properties": { "key": { "const": "cron.max_parallel_jobs" }, "value": { "anyOf": [{ "type": "integer", "minimum": 1, "maximum": 64 }, { "type": "null" }] } }, "required": ["key", "value"], "additionalProperties": false },
    { "type": "object", "properties": { "key": { "const": "cron.output_retention" }, "value": { "type": "integer", "minimum": 0, "maximum": 10000 } }, "required": ["key", "value"], "additionalProperties": false },
    { "type": "object", "properties": { "key": { "const": "cron.script_timeout_seconds" }, "value": { "type": "integer", "minimum": 1, "maximum": 86400 } }, "required": ["key", "value"], "additionalProperties": false },
    { "type": "object", "properties": { "key": { "const": "cron.session_db_timeout_seconds" }, "value": { "type": "integer", "minimum": 0, "maximum": 3600 } }, "required": ["key", "value"], "additionalProperties": false },
    { "type": "object", "properties": { "key": { "const": "cron.failure_repeat_alert_hours" }, "value": { "type": "integer", "minimum": 0, "maximum": 168 } }, "required": ["key", "value"], "additionalProperties": false },
    { "type": "object", "properties": { "key": { "const": "gateway.startup_watchdog_timeout_seconds" }, "value": { "type": "integer", "minimum": 30, "maximum": 3600 } }, "required": ["key", "value"], "additionalProperties": false },
    { "type": "object", "properties": { "key": { "const": "gateway.restart_loop_guard.max_restarts" }, "value": { "type": "integer", "minimum": 0, "maximum": 20 } }, "required": ["key", "value"], "additionalProperties": false },
    { "type": "object", "properties": { "key": { "const": "gateway.respawn_storm.max_starts" }, "value": { "type": "integer", "minimum": 0, "maximum": 100 } }, "required": ["key", "value"], "additionalProperties": false },
    { "type": "object", "properties": { "key": { "const": "gateway.signal_interrupt_grace_timeout" }, "value": { "type": "number", "minimum": 0, "maximum": 60 } }, "required": ["key", "value"], "additionalProperties": false },
    { "type": "object", "properties": { "key": { "const": "logging.level" }, "value": { "enum": ["DEBUG", "INFO", "WARNING"] } }, "required": ["key", "value"], "additionalProperties": false },
    { "type": "object", "properties": { "key": { "const": "logging.max_size_mb" }, "value": { "type": "integer", "minimum": 1, "maximum": 100 } }, "required": ["key", "value"], "additionalProperties": false },
    { "type": "object", "properties": { "key": { "const": "logging.backup_count" }, "value": { "type": "integer", "minimum": 1, "maximum": 50 } }, "required": ["key", "value"], "additionalProperties": false },
    { "type": "object", "properties": { "key": { "const": "plugin.activation" }, "pluginId": { "type": "string", "pattern": "^(?!.*\\.\\.)(?!/)(?!.*//)[A-Za-z0-9._/-]{1,100}$" }, "enabled": { "type": "boolean" } }, "required": ["key", "pluginId", "enabled"], "additionalProperties": false },
    { "type": "object", "properties": { "key": { "const": "mcp.httpServer" }, "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$" }, "url": { "anyOf": [{ "type": "string", "minLength": 10, "maxLength": 2048, "pattern": "^https://" }, { "type": "null" }] }, "enabled": { "type": "boolean" } }, "required": ["key", "name", "url", "enabled"], "additionalProperties": false },
    { "type": "object", "properties": { "key": { "const": "mcp.activation" }, "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$" }, "enabled": { "type": "boolean" } }, "required": ["key", "name", "enabled"], "additionalProperties": false },
    { "type": "object", "properties": { "key": { "const": "mcp.bearerCredential" }, "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$" }, "token": { "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[\\x21-\\x7e]+$" }, { "type": "null" }] } }, "required": ["key", "name", "token"], "additionalProperties": false },
    {
      "type": "object",
      "properties": {
        "key": { "enum": ["OPENROUTER_API_KEY", "OPENAI_API_KEY", "ANTHROPIC_API_KEY"] },
        "value": { "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[\\x20-\\x7e]+$" }, { "type": "null" }] }
      },
      "required": ["key", "value"],
      "additionalProperties": false
    }
  ]
}
