{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://friday.local/schemas/integrations/hermes-config-patch.schema.json",
  "title": "HermesConfigPatch",
  "oneOf": [
    {
      "type": "object",
      "properties": { "key": { "const": "model.provider" }, "value": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,64}$" } },
      "required": ["key", "value"], "additionalProperties": false
    },
    {
      "type": "object",
      "properties": { "key": { "const": "model.default" }, "value": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^\\s\\x00-\\x1f\\x7f]+$" } },
      "required": ["key", "value"], "additionalProperties": false
    },
    {
      "type": "object",
      "properties": { "key": { "const": "agent.reasoning_effort" }, "value": { "enum": ["", "none", "minimal", "low", "medium", "high", "xhigh", "max", "ultra"] } },
      "required": ["key", "value"], "additionalProperties": false
    },
    {
      "type": "object",
      "properties": { "key": { "const": "fallback.min_switch_reset_seconds" }, "value": { "type": "integer", "minimum": 0, "maximum": 3600 } },
      "required": ["key", "value"], "additionalProperties": false
    },
    {
      "type": "object",
      "properties": { "key": { "const": "fallback_model" }, "value": { "type": "array", "maxItems": 8, "items": { "type": "object",
        "properties": { "provider": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,64}$" },
          "model": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^\\s\\x00-\\x1f\\x7f]+$" } },
        "required": ["provider", "model"], "additionalProperties": false } } },
      "required": ["key", "value"], "additionalProperties": false
    },
    { "type": "object", "properties": { "key": { "const": "agent.auto_recovery_cycles" }, "value": { "type": "integer", "minimum": 0, "maximum": 20 } }, "required": ["key", "value"], "additionalProperties": false },
    { "type": "object", "properties": { "key": { "const": "agent.run_budget_seconds" }, "value": { "anyOf": [{ "type": "integer", "minimum": 1, "maximum": 86400 }, { "type": "null" }] } }, "required": ["key", "value"], "additionalProperties": false },
    { "type": "object", "properties": { "key": { "const": "agent.budget_warning_ratio" }, "value": { "anyOf": [{ "type": "number", "minimum": 0.01, "maximum": 0.99 }, { "type": "null" }] } }, "required": ["key", "value"], "additionalProperties": false },
    { "type": "object", "properties": { "key": { "const": "agent.agent_cache.max_size" }, "value": { "type": "integer", "minimum": 1, "maximum": 4096 } }, "required": ["key", "value"], "additionalProperties": false },
    { "type": "object", "properties": { "key": { "const": "max_concurrent_sessions" }, "value": { "type": "integer", "minimum": 0, "maximum": 10000 } }, "required": ["key", "value"], "additionalProperties": false },
    { "type": "object", "properties": { "key": { "const": "context_file_max_chars" }, "value": { "type": "integer", "minimum": 0, "maximum": 1000000 } }, "required": ["key", "value"], "additionalProperties": false },
    { "type": "object", "properties": { "key": { "const": "compression.enabled" }, "value": { "type": "boolean" } }, "required": ["key", "value"], "additionalProperties": false },
    { "type": "object", "properties": { "key": { "const": "compression.threshold" }, "value": { "type": "number", "minimum": 0.1, "maximum": 0.95 } }, "required": ["key", "value"], "additionalProperties": false },
    { "type": "object", "properties": { "key": { "const": "compression.target_ratio" }, "value": { "type": "number", "minimum": 0.1, "maximum": 0.8 } }, "required": ["key", "value"], "additionalProperties": false },
    { "type": "object", "properties": { "key": { "const": "compression.tail_mode" }, "value": { "enum": ["lean", "legacy"] } }, "required": ["key", "value"], "additionalProperties": false },
    { "type": "object", "properties": { "key": { "const": "compression.protect_last_n" }, "value": { "type": "integer", "minimum": 0, "maximum": 100 } }, "required": ["key", "value"], "additionalProperties": false },
    {
      "type": "object",
      "properties": {
        "key": { "const": "agent.max_turns" },
        "value": { "type": "integer", "minimum": 1, "maximum": 100000 }
      },
      "required": ["key", "value"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "key": { "const": "agent.gateway_timeout" },
        "value": { "type": "integer", "minimum": 60, "maximum": 86400 }
      },
      "required": ["key", "value"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "key": { "const": "agent.api_max_retries" },
        "value": { "type": "integer", "minimum": 1, "maximum": 10 }
      },
      "required": ["key", "value"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": { "key": { "const": "session.terminal_continue" }, "value": { "type": "boolean" } },
      "required": ["key", "value"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "key": { "const": "max_live_sessions" },
        "value": { "type": "integer", "minimum": 0, "maximum": 10000 }
      },
      "required": ["key", "value"],
      "additionalProperties": false
    },
    { "type": "object", "properties": { "key": { "const": "terminal.timeout" }, "value": { "type": "integer", "minimum": 1, "maximum": 3600 } }, "required": ["key", "value"], "additionalProperties": false },
    { "type": "object", "properties": { "key": { "const": "browser.command_timeout" }, "value": { "type": "integer", "minimum": 5, "maximum": 600 } }, "required": ["key", "value"], "additionalProperties": false },
    { "type": "object", "properties": { "key": { "const": "browser.snapshot_threshold" }, "value": { "type": "integer", "minimum": 1000, "maximum": 200000 } }, "required": ["key", "value"], "additionalProperties": false },
    { "type": "object", "properties": { "key": { "const": "skills.disabled" }, "value": { "type": "array", "maxItems": 512, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9._/-]{1,100}$" } } }, "required": ["key", "value"], "additionalProperties": false },
    { "type": "object", "properties": { "key": { "const": "plugin.activation" }, "pluginId": { "type": "string", "pattern": "^(?!.*\\.\\.)(?!/)(?!.*//)[A-Za-z0-9._/-]{1,100}$" }, "enabled": { "type": "boolean" } }, "required": ["key", "pluginId", "enabled"], "additionalProperties": false },
    { "type": "object", "properties": { "key": { "const": "mcp.httpServer" }, "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$" }, "url": { "anyOf": [{ "type": "string", "minLength": 10, "maxLength": 2048, "pattern": "^https://" }, { "type": "null" }] }, "enabled": { "type": "boolean" } }, "required": ["key", "name", "url", "enabled"], "additionalProperties": false },
    {
      "type": "object",
      "properties": {
        "key": { "enum": ["OPENROUTER_API_KEY", "OPENAI_API_KEY", "ANTHROPIC_API_KEY"] },
        "value": { "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[\\x20-\\x7e]+$" }, { "type": "null" }] }
      },
      "required": ["key", "value"],
      "additionalProperties": false
    }
  ]
}
