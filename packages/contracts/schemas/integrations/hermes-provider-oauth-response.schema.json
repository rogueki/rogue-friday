{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://friday.local/schemas/integrations/hermes-provider-oauth-response.schema.json",
  "title": "HermesProviderOAuthResponse",
  "type": "object",
  "properties": {
    "contractVersion": { "$ref": "../common/contract-version.schema.json" },
    "data": { "type": "object", "properties": {
      "flowId": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
      "provider": { "enum": ["nous", "openai-codex", "xai-oauth", "minimax-oauth"] },
      "status": { "enum": ["starting", "awaiting_approval", "cancelling", "configured", "failed"] },
      "userCode": { "type": ["string", "null"], "maxLength": 64 },
      "verificationUrl": { "type": ["string", "null"], "maxLength": 2048 },
      "expiresAt": { "type": ["string", "null"], "format": "date-time" },
      "failureClass": { "type": ["string", "null"], "maxLength": 80 }
    }, "required": ["flowId", "provider", "status", "userCode", "verificationUrl", "expiresAt", "failureClass"],
      "additionalProperties": false },
    "freshness": { "$ref": "../common/freshness.schema.json" }
  },
  "required": ["contractVersion", "data", "freshness"],
  "additionalProperties": false
}
