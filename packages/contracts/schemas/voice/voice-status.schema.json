{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://friday.local/schemas/voice/voice-status.schema.json",
  "title": "VoiceStatus",
  "description": "Live voice pipeline status (PLAN §38.1). Microphone activity is always visible.",
  "type": "object",
  "properties": {
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "$ref": "../common/source-descriptor.schema.json"
    },
    "mode": {
      "type": "string",
      "enum": ["idle", "listening", "transcribing", "thinking", "speaking", "error"]
    },
    "microphone": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": ["off", "muted", "idle", "listening"]
        },
        "active": {
          "type": "boolean"
        },
        "deviceId": {
          "type": ["string", "null"]
        },
        "inputLevel": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": ["state", "active", "deviceId", "inputLevel"],
      "additionalProperties": false
    },
    "wakeWord": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "state": {
          "type": "string",
          "enum": ["disabled", "armed", "triggered", "error"]
        },
        "phrase": {
          "type": "string"
        }
      },
      "required": ["enabled", "state", "phrase"],
      "additionalProperties": false
    },
    "speakerVerification": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "state": {
          "type": "string",
          "enum": ["disabled", "idle", "verifying", "verified", "rejected"]
        },
        "recognizedSpeaker": {
          "type": ["string", "null"]
        },
        "confidence": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": ["enabled", "state", "recognizedSpeaker", "confidence"],
      "additionalProperties": false
    },
    "trustedSession": {
      "type": "object",
      "properties": {
        "active": {
          "type": "boolean"
        },
        "expiresAt": {
          "type": ["string", "null"],
          "format": "date-time"
        }
      },
      "required": ["active", "expiresAt"],
      "additionalProperties": false
    },
    "stt": {
      "type": "object",
      "properties": {
        "engine": {
          "type": "string"
        },
        "state": {
          "type": "string",
          "enum": ["ready", "busy", "error", "offline"]
        },
        "latencyMs": {
          "type": ["integer", "null"],
          "minimum": 0
        }
      },
      "required": ["engine", "state", "latencyMs"],
      "additionalProperties": false
    },
    "tts": {
      "type": "object",
      "properties": {
        "engine": {
          "type": "string"
        },
        "state": {
          "type": "string",
          "enum": ["ready", "busy", "error", "offline"]
        },
        "latencyMs": {
          "type": ["integer", "null"],
          "minimum": 0
        }
      },
      "required": ["engine", "state", "latencyMs"],
      "additionalProperties": false
    },
    "localModel": {
      "type": "object",
      "properties": {
        "name": {
          "type": ["string", "null"]
        },
        "state": {
          "type": "string",
          "enum": ["ready", "busy", "error", "offline"]
        },
        "latencyMs": {
          "type": ["integer", "null"],
          "minimum": 0
        }
      },
      "required": ["name", "state", "latencyMs"],
      "additionalProperties": false
    },
    "audioInputDeviceId": {
      "type": ["string", "null"]
    },
    "ttsVoiceChoice": { "type": ["string", "null"] },
    "audioPath": {
      "type": "object",
      "description": "Which runtime owns audio right now: local devices of the Windows or Linux voice service, or the browser.",
      "properties": {
        "transport": { "type": "string", "enum": ["device", "browser"] },
        "host": { "anyOf": [{ "type": "null" }, { "type": "string", "enum": ["windows", "linux"] }] }
      },
      "required": ["transport", "host"],
      "additionalProperties": false
    },
    "serviceStartedAt": { "type": ["string", "null"], "format": "date-time" },
    "audioDeviceWaiting": {
      "type": "boolean",
      "description": "True while the voice service waits for its selected audio device (disconnected or not yet available); it resumes on its own when the device returns."
    },
    "audioOutputDeviceId": {
      "type": ["string", "null"]
    },
    "pushToTalk": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "active": {
          "type": "boolean"
        }
      },
      "required": ["enabled", "active"],
      "additionalProperties": false
    },
    "focusMode": {
      "type": "boolean"
    },
    "rawRecordingEnabled": {
      "type": "boolean"
    },
    "voiceHistoryEnabled": {
      "type": "boolean"
    }
  },
  "required": [
    "updatedAt",
    "source",
    "mode",
    "microphone",
    "wakeWord",
    "speakerVerification",
    "trustedSession",
    "stt",
    "tts",
    "localModel",
    "audioInputDeviceId",
    "audioOutputDeviceId",
    "pushToTalk",
    "focusMode",
    "rawRecordingEnabled",
    "voiceHistoryEnabled"
  ],
  "additionalProperties": false
}
