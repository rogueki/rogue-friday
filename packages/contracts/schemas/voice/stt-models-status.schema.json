{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://friday.local/schemas/voice/stt-models-status.schema.json",
  "title": "SttModelsStatus",
  "type": "object",
  "properties": {
    "contractVersion": { "$ref": "../common/contract-version.schema.json" },
    "localMode": { "type": "boolean" },
    "models": { "type": "array", "items": { "type": "object", "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$" },
      "cached": { "type": "boolean" }
    }, "required": ["id", "cached"], "additionalProperties": false } },
    "job": { "oneOf": [{ "type": "null" }, { "type": "object", "properties": {
      "id": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
      "model": { "type": "string", "enum": ["base", "small", "medium"] },
      "state": { "type": "string", "enum": ["downloading", "cancelling", "ready", "failed", "cancelled"] },
      "error": { "type": ["string", "null"] }
    }, "required": ["id", "model", "state", "error"], "additionalProperties": false }] }
  },
  "required": ["contractVersion", "localMode", "models", "job"],
  "additionalProperties": false
}
