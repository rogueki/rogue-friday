{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis.local/schemas/memory/memory-create-request.schema.json",
  "title": "MemoryCreateRequest",
  "type": "object",
  "properties": {
    "type": {
      "$ref": "../memory/memory-type.schema.json"
    },
    "content": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "../memory/memory-entity.schema.json"
      }
    },
    "sensitivity": {
      "$ref": "../memory/memory-sensitivity.schema.json"
    },
    "pinned": {
      "type": "boolean"
    },
    "expiresAt": {
      "type": ["string", "null"],
      "format": "date-time"
    }
  },
  "required": ["type", "content"],
  "additionalProperties": false
}
