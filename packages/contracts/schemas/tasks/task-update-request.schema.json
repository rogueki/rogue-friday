{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://friday.local/schemas/tasks/task-update-request.schema.json",
  "title": "TaskUpdateRequest",
  "description": "Partial update (also used for Kanban moves via status). Requires If-Match.",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "description": {
      "type": "string"
    },
    "status": {
      "$ref": "../tasks/task-status.schema.json"
    },
    "priority": {
      "$ref": "../common/priority.schema.json"
    },
    "agentId": {
      "type": ["string", "null"],
      "pattern": "^agent_[0-9A-Za-z]{26}$"
    },
    "dueAt": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false,
  "minProperties": 1
}
