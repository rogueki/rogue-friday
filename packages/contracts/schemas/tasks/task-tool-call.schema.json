{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis.local/schemas/tasks/task-tool-call.schema.json",
  "title": "TaskToolCall",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^tcall_[0-9A-Za-z]{26}$"
    },
    "tool": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["running", "succeeded", "failed"]
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "durationMs": {
      "type": "integer",
      "minimum": 0
    },
    "summary": {
      "type": "string"
    },
    "adapterId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "minLength": 1,
      "maxLength": 64
    },
    "error": {
      "$ref": "../common/error-detail.schema.json"
    }
  },
  "required": ["id", "tool", "status", "startedAt"],
  "additionalProperties": false
}
