{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://friday.local/schemas/settings/telephony-profile-patch.schema.json",
  "title": "TelephonyProfilePatch",
  "type": "object",
  "properties": {
    "mode": { "type": "string", "enum": ["local", "trunk"] },
    "ariUser": { "type": "string", "minLength": 1, "maxLength": 40 },
    "ariPassword": { "type": "string", "minLength": 12, "maxLength": 200 },
    "ariPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "ownerEndpoint": { "type": "string", "minLength": 1, "maxLength": 40 },
    "callerId": { "type": "string", "minLength": 3, "maxLength": 16 },
    "sipHost": { "type": "string", "maxLength": 253 },
    "sipUser": { "type": "string", "maxLength": 200 },
    "sipPassword": { "type": "string", "maxLength": 200 }
  },
  "required": ["mode", "ariUser", "ariPassword", "ariPort", "ownerEndpoint", "callerId"],
  "additionalProperties": false
}
