{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://friday.local/schemas/settings/telegram-gateway.schema.json",
  "title": "TelegramGateway",
  "type": "object",
  "properties": {
    "tokenConfigured": { "type": "boolean" },
    "allowedUserIds": { "type": "array", "items": { "type": "string" } },
    "enabled": { "type": ["boolean", "null"] },
    "gatewayRunning": { "type": ["boolean", "null"] },
    "connectionState": { "type": "string", "enum": ["unknown"] },
    "applied": { "type": ["boolean", "null"] },
    "revision": { "type": "integer", "minimum": 0 }
  },
  "required": ["tokenConfigured", "allowedUserIds", "enabled", "gatewayRunning", "connectionState", "applied", "revision"],
  "additionalProperties": false
}
