{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis.local/schemas/settings/settings.schema.json",
  "title": "Settings",
  "description": "All 14 settings areas (PLAN §42.1). adapters lists configuration state; secrets only as { configured }.",
  "type": "object",
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "profile": {
      "$ref": "../settings/profile-settings.schema.json"
    },
    "dashboard": {
      "$ref": "../settings/dashboard-settings.schema.json"
    },
    "theme": {
      "$ref": "../settings/theme-settings.schema.json"
    },
    "orb": {
      "$ref": "../settings/orb-settings.schema.json"
    },
    "navigation": {
      "$ref": "../settings/navigation-settings.schema.json"
    },
    "modelsRouting": {
      "$ref": "../settings/models-routing-settings.schema.json"
    },
    "voice": {
      "$ref": "../settings/voice-settings.schema.json"
    },
    "notifications": {
      "$ref": "../settings/notifications-settings.schema.json"
    },
    "security": {
      "$ref": "../settings/security-settings.schema.json"
    },
    "approvals": {
      "$ref": "../settings/approvals-settings.schema.json"
    },
    "dataRetention": {
      "$ref": "../settings/data-retention-settings.schema.json"
    },
    "backups": {
      "$ref": "../settings/backups-settings.schema.json"
    },
    "developer": {
      "$ref": "../settings/developer-settings.schema.json"
    },
    "adapters": {
      "type": "array",
      "items": {
        "$ref": "../settings/adapter-config-settings.schema.json"
      }
    }
  },
  "required": [
    "version",
    "updatedAt",
    "profile",
    "dashboard",
    "theme",
    "orb",
    "navigation",
    "modelsRouting",
    "voice",
    "notifications",
    "security",
    "approvals",
    "dataRetention",
    "backups",
    "developer",
    "adapters"
  ],
  "additionalProperties": false
}
