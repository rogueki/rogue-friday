{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://friday.local/schemas/settings/voice-settings.schema.json",
  "title": "VoiceSettings",
  "type": "object",
  "properties": {
    "wakeWordEnabled": {
      "type": "boolean"
    },
    "wakeWord": {
      "type": "string"
    },
    "pushToTalkKey": {
      "type": "string"
    },
    "speakerVerificationRequired": {
      "type": "boolean"
    },
    "storeRawRecordings": {
      "type": "boolean",
      "default": false
    },
    "voiceHistoryEnabled": {
      "type": "boolean"
    },
    "sttLanguage": { "type": "string", "enum": ["de", "en"] },
    "sttModel": { "type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$" },
    "conversationBackend": {
      "type": "string",
      "enum": ["local", "qwen"],
      "description": "Who leads the spoken conversation: the local pipeline or Qwen Audio over the Alibaba Token Plan (wake word, speaker check and voice stay local)."
    },
    "conversationConsent": {
      "type": "boolean",
      "description": "The owner agreed that speech and conversation content go to Alibaba Cloud (Qwen Audio, Token Plan); missing or false keeps the conversation local."
    },
    "ttsVoice": {
      "type": "string"
    },
    "ttsRate": {
      "type": "number",
      "minimum": 0.5,
      "maximum": 2
    },
    "inputDeviceId": {
      "type": ["string", "null"]
    },
    "outputDeviceId": {
      "type": ["string", "null"]
    }
  },
  "required": [
    "wakeWordEnabled",
    "wakeWord",
    "pushToTalkKey",
    "speakerVerificationRequired",
    "storeRawRecordings",
    "voiceHistoryEnabled",
    "ttsVoice",
    "ttsRate",
    "inputDeviceId",
    "outputDeviceId"
  ],
  "additionalProperties": false
}
