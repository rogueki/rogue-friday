{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis.local/schemas/settings/notifications-settings.schema.json",
  "title": "NotificationSettings",
  "type": "object",
  "properties": {
    "channels": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["dashboard", "telegram", "whatsapp", "sms", "phone", "email"]
          },
          "enabled": {
            "type": "boolean"
          },
          "minPriority": {
            "$ref": "../common/priority.schema.json"
          }
        },
        "required": ["kind", "enabled", "minPriority"],
        "additionalProperties": false
      }
    },
    "quietHours": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "from": {
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        },
        "to": {
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        }
      },
      "required": ["enabled", "from", "to"],
      "additionalProperties": false
    },
    "defaultEscalation": {
      "type": "array",
      "items": {
        "$ref": "../automations/escalation-step.schema.json"
      }
    },
    "snoozeDefaultMinutes": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": ["channels", "quietHours", "defaultEscalation", "snoozeDefaultMinutes"],
  "additionalProperties": false
}
