{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://friday.local/schemas/settings/gateway-pairing.schema.json",
  "title": "GatewayPairing",
  "type": "object",
  "properties": {
    "platforms": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "properties": {
          "platform": { "type": "string", "enum": ["telegram", "discord", "whatsapp"] },
          "pending": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "object",
              "properties": {
                "requestId": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
                "userId": { "type": "string", "pattern": "^[A-Za-z0-9@._:+-]{1,128}$" },
                "userName": { "type": "string", "maxLength": 128 },
                "ageMinutes": { "type": "integer", "minimum": 0 }
              },
              "required": ["requestId", "userId", "userName", "ageMinutes"],
              "additionalProperties": false
            }
          },
          "approved": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "type": "object",
              "properties": {
                "userId": { "type": "string", "pattern": "^[A-Za-z0-9@._:+-]{1,128}$" },
                "userName": { "type": "string", "maxLength": 128 },
                "approvedAt": { "type": ["string", "null"], "format": "date-time" }
              },
              "required": ["userId", "userName", "approvedAt"],
              "additionalProperties": false
            }
          }
        },
        "required": ["platform", "pending", "approved"],
        "additionalProperties": false
      }
    }
  },
  "required": ["platforms"],
  "additionalProperties": false
}
