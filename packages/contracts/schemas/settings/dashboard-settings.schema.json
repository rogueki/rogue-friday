{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://friday.local/schemas/settings/dashboard-settings.schema.json",
  "title": "DashboardSettings",
  "type": "object",
  "properties": {
    "activeLayoutId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "minLength": 1,
      "maxLength": 64
    },
    "fontScale": {
      "type": "number",
      "minimum": 0.8,
      "maximum": 1.4
    },
    "backgroundGrid": {
      "type": "boolean"
    },
    "soundEffects": {
      "type": "boolean"
    },
    "autoRefreshSeconds": {
      "type": "integer",
      "minimum": 5,
      "maximum": 3600
    },
    "compact": {
      "type": "boolean"
    },
    "contentStudioEnabled": {
      "type": "boolean",
      "description": "Enables the optional Content Studio module. Missing on older settings means disabled."
    },
    "location": {
      "description": "Confirmed coarse dashboard location; absent or null means no location was chosen.",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "properties": {
            "label": { "type": "string", "minLength": 1, "maxLength": 120 },
            "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
            "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
            "countryCode": { "type": "string", "pattern": "^[A-Z]{2}$" }
          },
          "required": ["label", "latitude", "longitude"],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "activeLayoutId",
    "fontScale",
    "backgroundGrid",
    "soundEffects",
    "autoRefreshSeconds",
    "compact"
  ],
  "additionalProperties": false
}
