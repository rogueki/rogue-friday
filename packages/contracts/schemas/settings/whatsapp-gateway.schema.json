{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://friday.local/schemas/settings/whatsapp-gateway.schema.json",
  "title": "WhatsappGateway",
  "type": "object",
  "properties": {
    "setupUrl": { "type": "string", "pattern": "^http://127\\.0\\.0\\.1:[0-9]{1,5}/channels$" },
    "mode": { "type": ["string", "null"], "enum": ["bot", "self-chat", null] },
    "sessionPresent": { "type": "boolean" },
    "allowedUserIds": { "type": "array", "items": { "type": "string" } },
    "enabled": { "type": ["boolean", "null"] },
    "gatewayRunning": { "type": ["boolean", "null"] },
    "connectionState": { "type": "string", "enum": ["connected", "disconnected", "unknown"] },
    "applied": { "type": ["boolean", "null"] },
    "revision": { "type": "integer", "minimum": 0 },
    "groupPolicy": { "type": ["string", "null"], "enum": ["open", "allowlist", "disabled", "pairing", null], "description": "Stored WHATSAPP_GROUP_POLICY; null when unset. Hermes forwards group messages only for allowlist (listed groups) and open (all groups)." },
    "groupAllowedIds": { "type": "array", "items": { "type": "string" }, "description": "Group JIDs from WHATSAPP_GROUP_ALLOWED_USERS." },
    "requireMention": { "type": ["boolean", "null"], "description": "WHATSAPP_REQUIRE_MENTION; null when unset (Hermes default false)." },
    "replyPrefix": { "type": ["string", "null"], "description": "Header line above every WhatsApp reply; null when unset, then Hermes adds its own header." }
  },
  "required": ["setupUrl", "mode", "sessionPresent", "allowedUserIds", "enabled", "gatewayRunning", "connectionState", "applied", "revision", "groupPolicy", "groupAllowedIds", "requireMention", "replyPrefix"],
  "additionalProperties": false
}
