{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://friday.local/schemas/settings/approvals-settings.schema.json",
  "title": "ApprovalSettings",
  "type": "object",
  "properties": {
    "defaultExpiryMinutes": {
      "type": "integer",
      "minimum": 1
    },
    "draftOnlyByDefault": {
      "type": "boolean",
      "default": true
    },
    "confirmTier2": {
      "type": "boolean"
    },
    "reauthTier3": {
      "type": "boolean",
      "default": true
    },
    "notifyOnRequest": {
      "type": "boolean"
    }
  },
  "required": [
    "defaultExpiryMinutes",
    "draftOnlyByDefault",
    "confirmTier2",
    "reauthTier3",
    "notifyOnRequest"
  ],
  "additionalProperties": false
}
