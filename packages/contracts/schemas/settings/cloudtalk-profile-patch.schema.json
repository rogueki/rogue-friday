{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://friday.local/schemas/settings/cloudtalk-profile-patch.schema.json",
  "title": "CloudTalkProfilePatch", "type": "object",
  "properties": {
    "agentId": { "type": "integer", "minimum": 1 },
    "accessKeyId": { "type": "string", "minLength": 4, "maxLength": 200 },
    "accessKeySecret": { "type": "string", "minLength": 8, "maxLength": 500 },
    "ownerPhone": { "type": "string", "pattern": "^\\+[1-9][0-9]{7,14}$" },
    "ownerPhoneConfirmed": { "type": "boolean" },
    "voiceAgentId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,100}$" },
    "remindersEnabled": { "type": "boolean" },
    "reminderMinutes": { "type": "integer", "minimum": 1, "maximum": 120 }
  }, "required": ["accessKeyId", "accessKeySecret"], "additionalProperties": false
}
