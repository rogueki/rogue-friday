{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://friday.local/schemas/settings/whatsapp-gateway-patch.schema.json",
  "title": "WhatsappGatewayPatch",
  "type": "object",
  "properties": {
    "mode": { "type": "string", "enum": ["bot", "self-chat"] },
    "allowedUserIds": { "type": "array", "maxItems": 10, "uniqueItems": true, "items": { "type": "string", "pattern": "^[1-9][0-9]{5,19}$" } },
    "enabled": { "type": "boolean" }
  },
  "required": ["mode", "allowedUserIds", "enabled"],
  "additionalProperties": false
}
