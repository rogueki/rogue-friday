{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://friday.local/schemas/communication/cloudtalk-call-response.schema.json",
  "title": "CloudTalkCallResponse", "type": "object",
  "properties": {
    "contractVersion": { "$ref": "../common/contract-version.schema.json" },
    "data": { "type": "object", "properties": {
      "id": { "type": "string", "pattern": "^ctcall_[a-f0-9]{32}$" },
      "destination": { "type": "string" },
      "state": { "type": "string", "enum": ["pending", "requested", "rejected", "unknown"] },
      "providerStatus": { "type": ["integer", "null"] },
      "createdAt": { "type": "string", "format": "date-time" },
      "updatedAt": { "type": "string", "format": "date-time" },
      "replayed": { "type": "boolean" }, "note": { "type": "string" }
    }, "required": ["id", "destination", "state", "providerStatus", "createdAt", "updatedAt", "note"], "additionalProperties": false },
    "freshness": { "$ref": "../common/freshness.schema.json" }
  }, "required": ["contractVersion", "data", "freshness"], "additionalProperties": false
}
