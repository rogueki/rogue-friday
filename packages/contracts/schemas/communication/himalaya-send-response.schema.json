{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://friday.local/schemas/communication/himalaya-send-response.schema.json",
  "title": "HimalayaSendResponse",
  "type": "object",
  "properties": {
    "contractVersion": { "$ref": "../common/contract-version.schema.json" },
    "data": { "type": "object", "properties": {
      "state": { "type": "string", "enum": ["sent", "unknown"] },
      "replayed": { "type": "boolean" }
    }, "required": ["state", "replayed"], "additionalProperties": false },
    "freshness": { "$ref": "../common/freshness.schema.json" }
  },
  "required": ["contractVersion", "data", "freshness"], "additionalProperties": false
}
