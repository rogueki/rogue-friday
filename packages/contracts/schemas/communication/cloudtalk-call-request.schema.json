{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://friday.local/schemas/communication/cloudtalk-call-request.schema.json",
  "title": "CloudTalkCallRequest", "type": "object",
  "properties": {
    "destination": { "type": "string", "pattern": "^\\+[1-9][0-9]{7,14}$" },
    "previewToken": { "type": "string", "minLength": 20, "maxLength": 1200 }
  }, "required": ["destination", "previewToken"], "additionalProperties": false
}
