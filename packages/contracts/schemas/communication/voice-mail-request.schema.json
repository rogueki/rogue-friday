{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://friday.local/schemas/communication/voice-mail-request.schema.json",
  "title": "VoiceMailRequest",
  "type": "object",
  "properties": {
    "action": { "type": "string", "enum": ["compose", "reply", "move", "flag"] },
    "mailbox": { "type": "string", "minLength": 1, "maxLength": 200 },
    "id": { "type": "string", "pattern": "^[1-9][0-9]{0,17}$" },
    "destination": { "type": "string", "minLength": 1, "maxLength": 200 },
    "to": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "type": "string", "maxLength": 254 } },
    "subject": { "type": "string", "minLength": 1, "maxLength": 200 },
    "body": { "type": "string", "minLength": 1, "maxLength": 100000 }
  },
  "required": ["action"],
  "additionalProperties": false
}
