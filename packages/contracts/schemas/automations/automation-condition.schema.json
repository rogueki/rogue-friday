{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis.local/schemas/automations/automation-condition.schema.json",
  "title": "AutomationCondition",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "field": {
      "type": "string"
    },
    "operator": {
      "type": "string",
      "enum": ["eq", "neq", "gt", "gte", "lt", "lte", "contains", "in", "matches"]
    },
    "value": {
      "description": "Comparison value (any JSON)."
    },
    "description": {
      "type": "string"
    }
  },
  "required": ["id", "field", "operator", "value", "description"],
  "additionalProperties": false
}
