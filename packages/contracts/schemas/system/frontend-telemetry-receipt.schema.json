{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis.local/schemas/system/frontend-telemetry-receipt.schema.json",
  "title": "FrontendTelemetryReceipt",
  "description": "How much of a telemetry batch the server recorded.",
  "type": "object",
  "properties": {
    "acceptedErrors": {
      "type": "integer",
      "minimum": 0
    },
    "acceptedOrbSamples": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": ["acceptedErrors", "acceptedOrbSamples"],
  "additionalProperties": false
}
