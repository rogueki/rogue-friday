{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://friday.local/schemas/system/adapter-log-list-response.schema.json",
  "title": "AdapterLogListResponse",
  "description": "Recent log lines of one adapter, newest last. Not paginated: the buffer is bounded and limit caps the result.",
  "type": "object",
  "properties": {
    "contractVersion": {
      "$ref": "../common/contract-version.schema.json"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "../system/adapter-log-entry.schema.json"
      }
    },
    "freshness": {
      "$ref": "../common/freshness.schema.json"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "../common/source-descriptor.schema.json"
      }
    }
  },
  "required": ["contractVersion", "items", "freshness", "sources"],
  "additionalProperties": false
}
