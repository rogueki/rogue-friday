{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://friday.local/schemas/system/system-backup-status-response.schema.json",
  "title": "SystemBackupStatusResponse",
  "type": "object",
  "properties": {
    "contractVersion": { "type": "string" },
    "data": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "schedule": { "type": "string" },
        "timeZone": { "type": "string" },
        "targetPath": { "type": "string" },
        "running": { "type": "boolean" },
        "coverage": { "type": "string", "enum": ["windows-and-memory"] },
        "last": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "properties": {
                "at": { "type": "string", "format": "date-time" },
                "status": { "type": "string", "enum": ["success", "failed"] },
                "path": { "type": ["string", "null"] },
                "error": { "type": ["string", "null"] }
              },
              "required": ["at", "status", "path", "error"],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": ["enabled", "schedule", "timeZone", "targetPath", "running", "coverage", "last"],
      "additionalProperties": false
    },
    "freshness": { "$ref": "../common/freshness.schema.json" }
  },
  "required": ["contractVersion", "data", "freshness"],
  "additionalProperties": false
}
