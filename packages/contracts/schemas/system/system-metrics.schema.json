{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis.local/schemas/system/system-metrics.schema.json",
  "title": "SystemMetrics",
  "description": "Hardware snapshot (PLAN §40.1). Optional sensors are null when unavailable.",
  "type": "object",
  "properties": {
    "sampledAt": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "$ref": "../common/source-descriptor.schema.json"
    },
    "cpu": {
      "type": "object",
      "properties": {
        "usagePercent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "cores": {
          "type": "integer",
          "minimum": 1
        },
        "temperatureC": {
          "type": ["number", "null"]
        }
      },
      "required": ["usagePercent", "cores"],
      "additionalProperties": false
    },
    "ram": {
      "type": "object",
      "properties": {
        "usedBytes": {
          "type": "integer",
          "minimum": 0
        },
        "totalBytes": {
          "type": "integer",
          "minimum": 0
        },
        "usagePercent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      },
      "required": ["usedBytes", "totalBytes", "usagePercent"],
      "additionalProperties": false
    },
    "gpu": {
      "type": ["object", "null"],
      "properties": {
        "name": {
          "type": "string"
        },
        "usagePercent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "temperatureC": {
          "type": ["number", "null"]
        }
      },
      "required": ["name", "usagePercent"],
      "additionalProperties": false
    },
    "vram": {
      "type": ["object", "null"],
      "properties": {
        "usedBytes": {
          "type": "integer",
          "minimum": 0
        },
        "totalBytes": {
          "type": "integer",
          "minimum": 0
        },
        "usagePercent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      },
      "required": ["usedBytes", "totalBytes", "usagePercent"],
      "additionalProperties": false
    },
    "temperatures": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sensor": {
            "type": "string"
          },
          "celsius": {
            "type": "number"
          }
        },
        "required": ["sensor", "celsius"],
        "additionalProperties": false
      }
    },
    "storage": {
      "type": "array",
      "items": {
        "$ref": "../system/storage-volume.schema.json"
      }
    },
    "network": {
      "type": "object",
      "properties": {
        "rxBytesPerSec": {
          "type": "integer",
          "minimum": 0
        },
        "txBytesPerSec": {
          "type": "integer",
          "minimum": 0
        },
        "latencyMs": {
          "type": ["integer", "null"],
          "minimum": 0
        }
      },
      "required": ["rxBytesPerSec", "txBytesPerSec"],
      "additionalProperties": false
    }
  },
  "required": ["sampledAt", "source", "cpu", "ram", "gpu", "vram", "storage", "network"],
  "additionalProperties": false
}
