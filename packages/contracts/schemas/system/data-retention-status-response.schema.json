{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://friday.local/schemas/system/data-retention-status-response.schema.json",
  "title": "DataRetentionStatusResponse",
  "type": "object",
  "properties": {
    "contractVersion": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "properties": {
        "running": {
          "type": "boolean"
        },
        "last": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "at": {
                  "type": "string",
                  "format": "date-time"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "success",
                    "failed"
                  ]
                },
                "counts": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "activity": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "voiceHistory": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "auditToArchive": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "notifications": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "temporaryFiles": {
                          "type": "integer",
                          "minimum": 0
                        }
                      },
                      "required": [
                        "activity",
                        "voiceHistory",
                        "auditToArchive",
                        "notifications",
                        "temporaryFiles"
                      ],
                      "additionalProperties": false
                    }
                  ]
                },
                "confirmedPartial": {
                  "type": "object",
                  "properties": {
                    "activity": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "voiceHistory": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "auditToArchive": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "notifications": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "temporaryFiles": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": [],
                  "additionalProperties": false
                },
                "error": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "at",
                "status",
                "counts",
                "confirmedPartial",
                "error"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "running",
        "last"
      ],
      "additionalProperties": false
    },
    "freshness": {
      "$ref": "../common/freshness.schema.json"
    }
  },
  "required": [
    "contractVersion",
    "data",
    "freshness"
  ],
  "additionalProperties": false
}
