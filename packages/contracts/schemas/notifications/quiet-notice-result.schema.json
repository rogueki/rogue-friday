{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://friday.local/schemas/notifications/quiet-notice-result.schema.json",
  "title": "QuietNoticeResult",
  "description": "Outcome of a quiet notice; never echoes the text.",
  "type": "object",
  "properties": {
    "recorded": {
      "type": "boolean",
      "description": "false when quiet mode is not active"
    },
    "delivery": {
      "type": "string",
      "enum": [
        "sent",
        "uncertain",
        "skipped"
      ]
    },
    "reason": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    }
  },
  "required": [
    "recorded",
    "delivery",
    "reason"
  ],
  "additionalProperties": false
}
