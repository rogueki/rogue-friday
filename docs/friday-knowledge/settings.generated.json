{
  "note": "Generiert von scripts/knowledge/build-friday-knowledge.mjs – nicht von Hand ändern.",
  "areas": [
    {
      "id": "profile",
      "label": "Profil",
      "description": "Name, Assistentenname, Sprache und Zeitformat",
      "route": "/settings?area=profile",
      "fields": [
        {
          "name": "assistantName",
          "type": "string",
          "description": "Visible brand name of the assistant (UI, orb labels, voice copy). Optional; clients fall back to \"F.R.I.D.A.Y.\"."
        },
        {
          "name": "dateFormat",
          "type": "string",
          "enum": [
            "dd.MM.yyyy",
            "yyyy-MM-dd",
            "MM/dd/yyyy"
          ]
        },
        {
          "name": "displayName",
          "type": "string"
        },
        {
          "name": "firstDayOfWeek",
          "type": "string",
          "enum": [
            "monday",
            "sunday"
          ]
        },
        {
          "name": "locale",
          "type": "string",
          "enum": [
            "de",
            "en"
          ]
        },
        {
          "name": "timeFormat",
          "type": "string",
          "enum": [
            "24h",
            "12h"
          ]
        },
        {
          "name": "timeZone",
          "type": "string"
        }
      ],
      "defaults": {
        "assistantName": "F.R.I.D.A.Y.",
        "dateFormat": "dd.MM.yyyy",
        "displayName": "installationsabhängig",
        "firstDayOfWeek": "monday",
        "locale": "de",
        "timeFormat": "24h",
        "timeZone": "installationsabhängig"
      }
    },
    {
      "id": "dashboard",
      "label": "Dashboard",
      "description": "Schriftgröße, Raster, Töne, Aktualisierung und Startseite",
      "route": "/settings?area=dashboard",
      "fields": [
        {
          "name": "activeLayoutId",
          "type": "string"
        },
        {
          "name": "autoRefreshSeconds",
          "type": "integer",
          "minimum": 5,
          "maximum": 3600
        },
        {
          "name": "backgroundGrid",
          "type": "boolean"
        },
        {
          "name": "compact",
          "type": "boolean"
        },
        {
          "name": "contentStudioEnabled",
          "type": "boolean",
          "description": "Enables the optional Content Studio module. Missing on older settings means disabled."
        },
        {
          "name": "fontScale",
          "type": "number",
          "minimum": 0.8,
          "maximum": 1.4
        },
        {
          "name": "location",
          "type": "unknown",
          "description": "Confirmed coarse dashboard location; absent or null means no location was chosen."
        },
        {
          "name": "soundEffects",
          "type": "boolean"
        }
      ],
      "defaults": {
        "activeLayoutId": "installationsabhängig",
        "autoRefreshSeconds": 30,
        "backgroundGrid": true,
        "compact": false,
        "contentStudioEnabled": "installationsabhängig",
        "fontScale": 1,
        "soundEffects": false
      }
    },
    {
      "id": "layout",
      "label": "Dashboard-Layout",
      "description": "Widgets der Übersicht verschieben, skalieren und ausblenden",
