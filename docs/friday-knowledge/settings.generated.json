            "stopOnAcknowledge": true
          },
          {
            "afterSeconds": 300,
            "channel": "whatsapp",
            "description": "Nach 5 Minuten per WhatsApp",
            "stopOnAcknowledge": true
          }
        ],
        "importantClasses": [
          "agent_questions",
          "approvals"
        ],
        "quietHours": {
          "enabled": true,
          "from": "22:00",
          "to": "07:00",
          "level": "silent",
          "summaryAt": "first_interaction"
        },
        "quietMode": {
          "level": "silent"
        },
        "quietTextTargetId": null,
        "snoozeDefaultMinutes": 30
      }
