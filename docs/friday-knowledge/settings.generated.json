    {
      "id": "voice",
      "label": "Sprache",
      "description": "Wake Word, Push-to-talk, Sprecherprüfung und Audiogeräte",
      "route": "/settings?area=voice",
      "fields": [
        {
          "name": "conversationBackend",
          "type": "string",
          "enum": [
            "local",
            "qwen"
          ],
          "description": "Who leads the spoken conversation: the local pipeline or Qwen Audio over the Alibaba Token Plan (wake word, speaker check and voice stay local)."
        },
        {
          "name": "conversationConsent",
          "type": "boolean",
          "description": "The owner agreed that speech and conversation content go to Alibaba Cloud (Qwen Audio, Token Plan); missing or false keeps the conversation local."
        },
        {
          "name": "conversationRegion",
          "type": "string",
          "enum": [
            "ap-southeast-1",
            "cn-beijing"
          ],
          "description": "Alibaba Cloud region of the Token Plan used by Qwen Audio (international Singapore or mainland China); must match where the key was issued. Missing means ap-southeast-1."
        },
        {
          "name": "conversationSilenceSeconds",
          "type": "integer",
          "minimum": 5,
          "maximum": 120,
          "description": "Silence after an answer until the conversation ends and the wake word is needed again; missing means 20."
        },
        {
          "name": "inputDeviceId",
          "type": [
            "string",
            "null"
          ]
        },
        {
          "name": "outputDeviceId",
          "type": [
            "string",
            "null"
          ]
        },
        {
          "name": "proactiveAnnouncements",
          "type": "boolean",
          "description": "Friday speaks background results on her own; false holds them until the owner's next request. Missing means true."
        },
        {
          "name": "pushToTalkKey",
          "type": "string"
        },
        {
          "name": "speakerVerificationRequired",
          "type": "boolean"
        },
        {
          "name": "storeRawRecordings",
          "type": "boolean"
        },
        {
          "name": "sttLanguage",
          "type": "string",
          "enum": [
            "de",
            "en"
          ]
        },
        {
          "name": "sttModel",
          "type": [
            "string",
            "null"
          ]
        },
        {
          "name": "ttsRate",
          "type": "number",
          "minimum": 0.5,
          "maximum": 2
        },
        {
          "name": "ttsVoice",
          "type": "string"
        },
        {
          "name": "voiceHistoryEnabled",
          "type": "boolean"
        },
        {
          "name": "wakeWord",
          "type": "string"
        },
        {
          "name": "wakeWordEnabled",
          "type": "boolean"
        }
      ],
      "defaults": {
        "conversationBackend": "local",
        "conversationConsent": false,
        "conversationRegion": "ap-southeast-1",
        "conversationSilenceSeconds": 20,
        "inputDeviceId": null,
        "outputDeviceId": null,
        "proactiveAnnouncements": true,
        "pushToTalkKey": "Ctrl+Space",
        "speakerVerificationRequired": true,
        "storeRawRecordings": false,
        "sttLanguage": "de",
        "sttModel": null,
        "ttsRate": 1,
        "ttsVoice": "",
        "voiceHistoryEnabled": true,
        "wakeWord": "Hey Friday",
        "wakeWordEnabled": true
      }
    },
    {
      "id": "notifications",
