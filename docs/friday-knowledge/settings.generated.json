            "minPriority": "P2"
          },
          {
            "kind": "whatsapp",
            "enabled": false,
            "minPriority": "P1"
          },
          {
            "kind": "sms",
            "enabled": false,
            "minPriority": "P0"
          },
          {
            "kind": "phone",
            "enabled": false,
            "minPriority": "P0"
          },
          {
            "kind": "email",
            "enabled": true,
            "minPriority": "P3"
          }
        ],
        "defaultEscalation": [
          {
            "afterSeconds": 0,
