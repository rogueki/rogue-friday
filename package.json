{
  "name": "friday-command-center",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "contracts:check": "pnpm --filter @friday/contracts check",
    "contracts:generate": "pnpm --filter @friday/contracts generate",
    "dev": "pnpm --parallel --filter @friday/control-api --filter @friday/web dev",
    "dev:api": "pnpm --filter @friday/control-api dev",
    "dev:web": "pnpm --filter @friday/web dev",
    "build": "pnpm -r --workspace-concurrency=1 build",
    "build:app": "pnpm -r --workspace-concurrency=1 --filter @friday/web --filter @friday/control-api build",
    "start": "pnpm --filter @friday/control-api start",
    "fake:upstreams": "tsx scripts/fake-upstreams/cli.ts",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:conformance": "pnpm --filter @friday/adapter-testkit test:conformance",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:integration": "playwright test --config playwright.integration.config.ts",
    "storybook": "pnpm --filter @friday/storybook dev",
    "scenario": "pnpm --filter @friday/mock-console start --"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
